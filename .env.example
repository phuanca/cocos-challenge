# Local database started with docker compose
DB_URL=jdbc:postgresql://localhost:5433/cocos
DB_USERNAME=cocos
DB_PASSWORD=cocos
POSTGRES_PORT=5433

# Optional OpenTelemetry tracing
OTEL_TRACES_ENABLED=false
OTEL_TRACES_SAMPLING_PROBABILITY=0.1
OTEL_METRICS_ENABLED=false
OTEL_SERVICE_NAME=cocos-challenge
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
